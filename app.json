{
  "expo": {
    "name": "CancioneroApp",
    "slug": "CancioneroApp",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación necesita acceso a tus fotos para cambiar el logo del coro."
        }
      ],
      "expo-router",
      "expo-splash-screen",
      "expo-image"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gerson.CarpetaIglesia",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mario.cancioneroapp"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "827684ad-d53c-4b1d-b159-d20d718cddb8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/827684ad-d53c-4b1d-b159-d20d718cddb8"
    }
  }
}
